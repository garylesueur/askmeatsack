{
  "name": "askmeatsack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:op": "node scripts/environment.mjs run development pnpm exec next dev --port 3043",
    "env": "node scripts/environment.mjs write development",
    "env:op-items": "node scripts/environment.mjs check development",
    "env:vercel": "bash scripts/sync-vercel-env.sh",
    "build": "node scripts/sync-icons.mjs && node scripts/sync-skill.mjs && next build",
    "start": "next start",
    "lint": "oxlint && node scripts/check-import-layers.mjs",
    "format": "oxfmt . '!.agents/**'",
    "format:check": "oxfmt --check . '!.agents/**'",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/sync-icons.mjs --check && vitest run",
    "sync:skill": "node scripts/sync-skill.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "env:check": "node scripts/environment.mjs check development"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "mcp-handler": "^1.1.0",
    "mermaid": "^11.16.1",
    "next": "16.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
